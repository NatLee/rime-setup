{
  "permissions": {
    "allow": [
      "Read",
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(pwsh tools/rime-test.ps1 *)",
      "Bash(bash scripts/rime-sync.sh*)",
      "Bash(/Library/Input Methods/Squirrel.app/Contents/MacOS/Squirrel --reload)",
      "PowerShell(pwsh tools\\rime-test.ps1 *)",
      "PowerShell(& \"C:\\Program Files\\Rime\\weasel-0.17.4\\WeaselDeployer.exe\" *)",
      "PowerShell(Stop-Process -Name WeaselServer *)",
      "PowerShell(Start-Process 'C:\\Program Files\\Rime\\weasel-0.17.4\\WeaselServer.exe'*)",
      "PowerShell(robocopy *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "PowerShell(git push --force*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/lua-restart-reminder.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
